{
  "permissions": {
    "allow": [
      "mcp__search-console__*",
      "mcp__serp-tracker__*",
      "mcp__keyword-research__*",
      "mcp__google-analytics__*",
      "mcp__ahrefs__*"
    ]
  },
  "mcpServers": {
    "search-console": {
      "command": "bash",
      "args": ["scripts/run-mcp.sh", "mcp/search-console/dist/index.js"]
    },
    "serp-tracker": {
      "command": "bash",
      "args": ["scripts/run-mcp.sh", "mcp/serp-tracker/dist/index.js"]
    },
    "keyword-research": {
      "command": "bash",
      "args": ["scripts/run-mcp.sh", "mcp/keyword-research/dist/index.js"]
    },
    "google-analytics": {
      "command": "bash",
      "args": ["scripts/run-mcp.sh", "mcp/google-analytics/dist/index.js"]
    },
    "ahrefs": {
      "command": "bash",
      "args": ["scripts/run-mcp.sh", "mcp/ahrefs/dist/index.js"]
    }
  }
}
